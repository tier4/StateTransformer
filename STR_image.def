BootStrap: docker
From: nvidia/cuda:11.1.1-cudnn8-devel-ubuntu20.04

%files
    {{ working_dir }} /envs/

%post
    cd /envs/
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/usr/local/cuda/bin:$PATH
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y && apt-get upgrade -y
    apt-get install -y \
    software-properties-common \
    wget && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    python3.9 \
    python3.9-dev \
    python3.9-distutils \
    python3.9-venv \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncurses5-dev \
    libncursesw5-dev \
    xz-utils \
    tk-dev \
    libffi-dev \
    liblzma-dev \
    libgdbm-dev \
    libnss3-dev \
    libedit-dev \
    libxml2-dev \
    libxmlsec1-dev \
    libffi-dev \
    liblzma-dev \
    libopencv-dev \
    curl \
    git 

    add-apt-repository ppa:ubuntu-toolchain-r/ppa
    apt update
    apt install g++-10 -y

    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-10 60 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-10 60 && \
    update-alternatives --config gcc && \
    update-alternatives --config g++

    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.9 1

    curl https://bootstrap.pypa.io/get-pip.py -o get-pip.py \
    && python3.9 get-pip.py \
    && rm get-pip.py

    cd STR2
    pip install pip==24.0
    pip install torch torchvision torchaudio
    pip install -r ./requirements.txt
    pip install git+https://github.com/motional/nuplan-devkit.git
    pip install -e .
    pip install waymo-open-dataset-tf-2-11-0==1.6.0
    pip install --upgrade transformers huggingface_hub
    
    chmod -R 777 ./
    chmod -R 777 /root/
    

%environment
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/usr/local/cuda/bin:$PATH